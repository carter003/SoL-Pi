{
  "name": "sol-omp",
  "version": "0.1.0-dev.0",
  "private": true,
  "type": "module",
  "description": "Evidence-Preserving Reducer and ObservationPack adapter for OMP 18.1.19",
  "license": "MIT",
  "bin": { "sol": "./src/codex/cli.ts" },
  "packageManager": "bun@1.3.14",
  "engines": { "bun": ">=1.3.14" },
  "omp": { "extensions": ["./src/index.ts"] },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:node": "node --experimental-strip-types --test tests/*.test.ts",
    "smoke": "bun scripts/smoke.ts",
    "sol": "bun src/codex/cli.ts"
  },
  "peerDependencies": { "@oh-my-pi/pi-coding-agent": "18.1.19", "@oh-my-pi/pi-ai": "18.1.19" },
  "devDependencies": {
    "@oh-my-pi/pi-coding-agent": "18.1.19",
    "@oh-my-pi/pi-ai": "18.1.19",
    "@types/bun": "1.3.14",
    "typescript": "5.8.3"
  }
}
